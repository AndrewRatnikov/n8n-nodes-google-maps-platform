{
  "name": "n8n-nodes-google-maps-platform",
  "version": "0.1.0",
  "description": "n8n community node for Google Maps Platform: Geocoding, Distance Matrix, Directions, and Timezone lookups.",
  "license": "MIT",
  "homepage": "https://github.com/AndrewRatnikov/n8n-nodes-google-maps-platform#readme",
  "keywords": ["n8n-community-node-package"],
  "author": { "name": "Andrew", "email": "ratnikov.am@gmail.com" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewRatnikov/n8n-nodes-google-maps-platform.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/GoogleMapsPlatformApi.credentials.js"],
    "nodes": ["dist/nodes/GoogleMapsPlatform/GoogleMapsPlatform.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
